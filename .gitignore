# Environment
.env
.env.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/

# Pipeline output (JSON exports, model artifacts)
output/
!output/.gitkeep

# API response cache
.cache/

# Local data store (harvest + computed outputs)
data/raw/
data/computed/

# Data seeds you don't want in git
data/*.csv

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json

# Local safety backups taken before destructive repairs. These are working-copy
# insurance, not artifacts — raw_backup_2026-05-22.zip predates this rule and is
# left tracked rather than rewritten out of history.
data/raw_backup_pre_*.zip
